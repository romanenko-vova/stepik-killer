# Telegram
TOKEN=

# Postgres (docker compose up -d db)
POSTGRES_USER=stepik
POSTGRES_PASSWORD=
POSTGRES_DB=stepik_killer
POSTGRES_PORT=5434
DATABASE_URL=postgresql+asyncpg://stepik:ПАРОЛЬ@127.0.0.1:5434/stepik_killer

# OpenRouter
OPENROUTER_API_KEY=
GPT_MODEL=x-ai/grok-4.3
REVIEW_MAX_TOKENS=1500
REVIEW_TEMPERATURE=0.9

# Песочница
DOCKER_IMAGE=python:3.12-slim
DOCKER_PARALLEL=3

# Админка: без пароля не стартует. Слушает только localhost — снаружи через ssh -L
ADMIN_USER=admin
ADMIN_PASSWORD=
ADMIN_HOST=127.0.0.1
ADMIN_PORT=8080

# Лимиты на пользователя в сутки
ATTEMPTS_PER_DAY=40
HINTS_PER_DAY=20

# Оффер. Выключен, пока тексты в config/funnel_texts.py и ссылка — черновики
OFFER_ENABLED=false
TRIAL_URL=https://romanenkouchit.ru/?utm_source=nottoxicbot
OFFER_AFTER_SOLVED=10
OFFER_AFTER_DAYS=3
OFFER_MIN_SOLVED=3
OFFER_REPEAT_DAYS=7
OFFER_MAX_SHOWS=2
