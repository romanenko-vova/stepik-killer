# Telegram
TOKEN=

# Postgres (docker compose up -d db)
POSTGRES_USER=stepik
POSTGRES_PASSWORD=
POSTGRES_DB=stepik_killer
POSTGRES_PORT=5434
DATABASE_URL=postgresql+asyncpg://stepik:ПАРОЛЬ@127.0.0.1:5434/stepik_killer

# OpenRouter
OPENROUTER_API_KEY=
GPT_MODEL=x-ai/grok-4.3
REVIEW_MAX_TOKENS=900
REVIEW_TEMPERATURE=0.9

# Песочница
DOCKER_IMAGE=python:3.12-slim
DOCKER_PARALLEL=3

# Админка: без пароля не стартует. Слушает только localhost — снаружи через ssh -L
ADMIN_USER=admin
ADMIN_PASSWORD=
ADMIN_HOST=127.0.0.1
ADMIN_PORT=8080
